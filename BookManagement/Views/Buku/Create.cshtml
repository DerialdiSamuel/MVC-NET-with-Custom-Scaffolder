@model BookManagement.Models.Buku

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Buku</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Judul" class="control-label"></label>
                <input asp-for="Judul" class="form-control" />
                <span asp-validation-for="Judul" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Penulis" class="control-label"></label>
                <input asp-for="Penulis" class="form-control" />
                <span asp-validation-for="Penulis" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="JenisBuku" class="control-label">Jenis Buku</label>
                <select asp-for="JenisBuku" class="form-control" asp-items="ViewBag.JenisBuku">
                    <option value="">-- Pilih Jenis Buku --</option>
                </select>
                <span asp-validation-for="JenisBuku" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TanggalRilis" class="control-label"></label>
                <input asp-for="TanggalRilis" type="date" class="form-control" />
                <span asp-validation-for="TanggalRilis" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="JumlahHalaman" class="control-label"></label>
                <input asp-for="JumlahHalaman" type="number" min="1" class="form-control" />
                <span asp-validation-for="JumlahHalaman" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
