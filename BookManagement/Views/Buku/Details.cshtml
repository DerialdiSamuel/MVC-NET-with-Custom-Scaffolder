@model BookManagement.Models.Buku

@{
    ViewData["Title"] = "Detail Buku";
}

<h1>Detail Buku</h1>
<dl class="row">
    <dt class="col-sm-2">Judul</dt>
    <dd class="col-sm-10">@Model.Judul</dd>
    <dt class="col-sm-2">Penulis</dt>
    <dd class="col-sm-10">@Model.Penulis</dd>
    <dt class="col-sm-2">Jenis Buku</dt>
    <dd class="col-sm-10">@Model.JenisBukuNavigation?.JenisBuku</dd>
    <dt class="col-sm-2">Tanggal Rilis</dt>
    <dd class="col-sm-10">@Model.TanggalRilis.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-2">Jumlah Halaman</dt>
    <dd class="col-sm-10">@Model.JumlahHalaman</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Kembali</a>
</div>
